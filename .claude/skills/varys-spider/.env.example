# Twitter/X API Credentials for Varys Spider
# Copy this file to .env and fill in your credentials

# Twitter/X Web Cookie Auth (from browser dev tools)
# Instructions:
# 1. Log in to x.com in your browser
# 2. Open DevTools (F12) → Application/Storage → Cookies
# 3. Copy values for auth_token and ct0
BIRD_AUTH_TOKEN=your_auth_token_here
BIRD_CT0=your_ct0_cookie_here

# Optional additional cookies (if needed)
BIRD_GUEST_ID=
BIRD_CF_CLEARANCE=

# OpenRouter API Key for Perplexity
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your_key_here
